{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeakEasy Mini",
  "identifier": "ai.speakeasy.mini",
  "build": {
    "beforeDevCommand": "npm run stage:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "SpeakEasy Mini settings",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 500,
        "visible": false,
        "focus": false
      },
      {
        "label": "hud-dock",
        "title": "SpeakEasy Mini",
        "width": 62,
        "height": 400,
        "minWidth": 62,
        "minHeight": 400,
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      },
      {
        "label": "notice",
        "title": "SpeakEasy Mini",
        "width": 360,
        "height": 192,
        "minWidth": 360,
        "minHeight": 192,
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "log",
        "title": "SpeakEasy Mini transcript log",
        "width": 340,
        "height": 460,
        "minWidth": 240,
        "minHeight": 180,
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
