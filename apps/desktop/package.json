{
  "name": "@speakeasy/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "stage:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/Stage-DevRuntime.ps1",
    "tauri": "tauri",
    "test": "npm run test:unit && npm run test:components",
    "test:components": "vitest run --coverage",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "=22.16.0",
    "npm": "=10.9.2"
  }
}
