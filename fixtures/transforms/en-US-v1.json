    { "mode": "plain_text", "input": "1/2/2030 5 km", "expected": "1/2/2030 5 km" },
    { "mode": "preserve_spoken_wording", "input": "one two three", "expected": "one two three" },
    { "mode": "literal", "input": "open ai\nsnippet signature", "expected": "open ai\nsnippet signature" },
    { "mode": "code", "input": "let open_ai = 1;", "expected": "let open_ai = 1;" },
